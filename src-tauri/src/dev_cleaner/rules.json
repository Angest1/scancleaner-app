{
  "schemaVersion": 1,
  "blacklistNever": {
    "exactNames": [".git", "local.properties"],
    "globPatterns": [".env", ".env.*", "*.jks", "*.keystore"],
    "dbDirNames": ["pgdata", "mysql", "mariadb", "mongodb", "sqlite", "postgres", "postgresql"],
    "sourceExtensions": [
      "rs",
      "ts",
      "tsx",
      "js",
      "jsx",
      "mjs",
      "cjs",
      "py",
      "php",
      "java",
      "kt",
      "kts",
      "cs",
      "fs",
      "vb",
      "go",
      "c",
      "cpp",
      "cc",
      "h",
      "hpp",
      "swift",
      "dart",
      "rb",
      "sql",
      "md",
      "vue",
      "svelte",
      "html",
      "css",
      "scss"
    ],
    "forbidDockerVolumes": true
  },
  "rules": [
    {
      "id": "node-npm-cache",
      "nombre": "Caché global de npm",
      "categoria": "Node",
      "tipo": "cache-global",
      "ubicacion": {
        "cliQuery": ["npm", "config", "get", "cache"],
        "envFallback": ["%LOCALAPPDATA%\\npm-cache"]
      },
      "deteccion": {
        "requiredMarkers": [],
        "requireGitIgnoredIfRepo": false,
        "requireProjectAgeDays": false
      },
      "nivel": "seguro",
      "metodo": {
        "tipo": "comando-oficial",
        "comando": ["npm", "cache", "clean", "--force"],
        "fallbackBorradoSiSinCli": true,
        "allowRecycleBinOption": false
      },
      "precondiciones": {
        "blockingProcesses": ["node.exe"],
        "preCommands": [],
        "requiresAdmin": false
      },
      "rutasAfectadas": ["%LOCALAPPDATA%\\npm-cache"],
      "comoRegenerar": "Se regenera automáticamente en el próximo `npm install`."
    },
